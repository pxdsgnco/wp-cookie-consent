<?xml version="1.0"?>
<ruleset name="Consent Raven Coding Standards">
	<description>PHPCS ruleset for the Consent Raven plugin.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/blocks/build/*</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Rules: WordPress VIP Go -->
	<rule ref="WordPress-VIP-Go">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Allow short array syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- Set minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="5.8"/>

	<!-- Check for PHP compatibility -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.2-"/>

	<!-- Verify text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="consent-raven"/>
			</property>
		</properties>
	</rule>

	<!-- Verify prefix -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="consent_raven"/>
				<element value="cr_"/>
				<element value="CR_"/>
				<element value="CONSENT_RAVEN"/>
			</property>
		</properties>
	</rule>

	<!-- File names -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>
</ruleset>
